{
  "expo": {
    "name": "TaqueControl",
    "slug": "TaqueriaKar",
    "description": "Control móvil de pedidos, menú, pagos y ventas para una taquería.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/taqueria-icon.png",
    "scheme": "taqueriakar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#181818",
        "foregroundImage": "./assets/images/taqueria-icon-foreground.png",
        "monochromeImage": "./assets/images/taqueria-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.jesuspmm.TaqueriaKar"
    },
    "androidNavigationBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "enforceContrast": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/taqueria-icon-foreground.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#181818",
          "dark": {
            "backgroundColor": "#181818"
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bcd294bb-3343-4229-a2cc-cbb32bbe03c1"
      }
    }
  }
}
